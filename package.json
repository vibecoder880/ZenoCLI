{
  "name": "zeno-cli",
  "version": "0.7.4",
  "description": "A professional multi-provider terminal coding agent.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qkhalk/ZenoCLI.git"
  },
  "homepage": "https://github.com/qkhalk/ZenoCLI#readme",
  "bugs": {
    "url": "https://github.com/qkhalk/ZenoCLI/issues"
  },
  "keywords": [
    "cli",
    "ai",
    "coding-agent",
    "openai",
    "anthropic",
    "gemini"
  ],
  "bin": {
    "zeno": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "prepare:release-notes": "node scripts/release-notes.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:verify": "npm run test && npm run typecheck && npm run lint && npm run build && npm pack --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run lint && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@iarna/toml": "^2.2.5",
    "chalk": "^5.4.1",
    "commander": "^14.0.1",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "open": "^10.1.2",
    "openai": "^5.12.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.6.0",
    "@types/react": "^18.3.12",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
